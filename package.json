{
  "name": "bigschool-tfm",
  "private": true,
  "scripts": {
    "build": "dotnet build bigschool-tfm.sln && npm --prefix src/resources-app run build",
    "test": "dotnet test src/resources-api-test/resources-api-test.csproj && npm --prefix src/resources-app-test test",
    "lint": "npm --prefix src/resources-app run lint",
    "presentation:capture": "node scripts/capture-project-presentation.mjs",
    "presentation:build": "node scripts/generate-project-presentation.mjs",
    "presentation:validate": "node scripts/validate-project-presentation.mjs docs/presentation/ResourceApp-TFM-Marcos-Palacios.pptx"
  },
  "devDependencies": {
    "adm-zip": "0.6.0",
    "playwright": "^1.62.1",
    "pptxgenjs": "^3.7.0"
  }
}
